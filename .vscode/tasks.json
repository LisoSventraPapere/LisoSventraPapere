{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc compila progetto completo",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I\"nightres/1) includes\"",
                "\"nightres/2) src/main.c\"",
                "\"nightres/2) src/tavoli.c\"",
                "\"nightres/2) src/clienti.c\"",
                "\"nightres/2) src/prenotazioni.c\"",
                "\"nightres/2) src/file_io.c\"",
                "\"nightres/2) src/utils.c\"",
                "-o",
                "${workspaceFolder}/nightres.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila tutti i file .c del progetto"
        }
    ],
    "version": "2.0.0"
}